{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "reviewers": [
    "h3nc4"
  ],
  "assignAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "The dev container pin belongs to CI, not to Renovate.",
      "matchManagers": ["devcontainer"],
      "enabled": false
    },
    {
      "description": "Android Gradle Plugin and Gradle move together",
      "groupName": "android-gradle",
      "matchPackageNames": [
        "com.android.application",
        "com.android.tools.build:gradle",
        "gradle"
      ]
    },
    {
      "description": "Kotlin and its Compose compiler plugin must stay on the same version",
      "groupName": "kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin.plugin.compose",
        "/^org.jetbrains.kotlin:/",
        "/^org.jetbrains.kotlinx:/"
      ]
    },
    {
      "groupName": "androidx",
      "matchPackageNames": [
        "/^androidx\\./"
      ]
    },
    {
      "description": "Group SonarQube server and scanner updates",
      "groupName": "sonarqube",
      "matchPackageNames": [
        "sonarqube",
        "sonarsource/sonar-scanner-cli"
      ]
    },
    {
      "description": "Disable unwanted pinning for SonarQube images",
      "matchPackageNames": [
        "sonarqube",
        "sonarsource/sonar-scanner-cli"
      ],
      "pinDigests": false
    },
    {
      "description": "The site's npm dependencies and the wrangler that deploys it move together",
      "groupName": "site",
      "matchFileNames": ["site/**", ".github/workflows/site.yaml"],
      "matchDatasources": ["npm"]
    },
    {
      "description": "Auto-merge all minor, patch, pin, and digest updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "addLabels": ["automerge"],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "description": "Update the wrangler version the site deploy installs",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/site\\.yaml$/"
      ],
      "matchStrings": [
        "wranglerVersion: \"(?<currentValue>.*?)\""
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "wrangler"
    }
  ]
}
