# shellcheck shell=sh

# Sourced by every script here. A suite decides what to assert, this decides how to say it.

# Find the checkout by locating this file, so a suite runs from anywhere.
if [ -z "${HG_ROOT:-}" ]; then
  _start="$(dirname -- "$0")"
  _d="$(CDPATH='' cd -- "${_start}" 2>/dev/null && pwd)" || _d="${PWD}"
  while [ "${_d}" != '/' ] && [ ! -f "${_d}/e2e/lib" ]; do
    _d="$(dirname "${_d}")"
  done
  if [ ! -f "${_d}/e2e/lib" ]; then
    echo "cannot locate the HyperGesture checkout, set HG_ROOT" >&2
    exit 1
  fi
  HG_ROOT="${_d}"
fi
cd "${HG_ROOT}" || exit 1

################################################################################
# Tools and constants

# Resolved from ANDROID_HOME, not PATH: a login shell sources /etc/profile, which drops
# the SDK directories.
ANDROID_HOME="${ANDROID_HOME:-/opt/android-sdk}"
ADB_BIN="${ANDROID_HOME}/platform-tools/adb"
EMULATOR_BIN="${ANDROID_HOME}/emulator/emulator"

AVD="${AVD:-hypergesture}"
PKG="com.h3nc4.hypergesture"
SERVICE="${PKG}/${PKG}.service.HyperGestureAccessibilityService"
LOG_DIR="build/e2e-logs"

# need_tool <path>
need_tool() {
  if [ ! -x "$1" ]; then
    echo "Missing $1. Is ANDROID_HOME correct? (got '${ANDROID_HOME}')" >&2
    exit 1
  fi
}

require_adb() {
  need_tool "${ADB_BIN}"
  mkdir -p "${LOG_DIR}"
}

# Only whoever boots an emulator needs its binary.
require_emulator() {
  require_adb
  need_tool "${EMULATOR_BIN}"
}

################################################################################
# Counting

passed=0
failed=0
failures=''

fail() {
  failed=$((failed + 1))
  failures="${failures}
  - $1"
  echo "  FAIL: $1" >&2
}

pass() {
  passed=$((passed + 1))
  echo "  ok: $1" >&2
}

# report <suite name> - the verdict, and the exit status a suite should carry.
report() {
  echo >&2
  echo "================ $1 ================" >&2
  echo "passed: ${passed}  failed: ${failed}" >&2
  if [ "${failed}" -ne 0 ]; then
    printf '%s\n' "${failures}" >&2
    return 1
  fi
  return 0
}

################################################################################
# Assertions
#
# logcat says what the service decided, dumpsys what the system did.

# Clears logcat, so each case asserts only on what it caused.
reset_log() {
  "${ADB_BIN}" logcat -c >/dev/null 2>&1 || true
}

# Prints this case's HyperGesture log lines.
gesture_log() {
  "${ADB_BIN}" logcat -d -s HyperGesture 2>/dev/null | tr -d '\r'
}

# assert_log <description> <grep-pattern>
assert_log() {
  # shellcheck disable=SC2310 # an empty log is a legitimate result, not a script error
  captured="$(gesture_log || true)"
  if printf '%s\n' "${captured}" | grep -q "$2"; then
    pass "$1"
  else
    fail "$1 (no log matching '$2')"
    printf '%s\n' "${captured}" | sed 's/^/        /' >&2
  fi
}

# log_has <grep-pattern> - quiet predicate, for chaining a secondary assertion onto a
# primary one so a system-performed action cannot be mistaken for one of ours.
log_has() {
  # shellcheck disable=SC2310 # an empty log is a legitimate result, not a script error
  captured="$(gesture_log || true)"
  printf '%s\n' "${captured}" | grep -q "$1"
}

# assert_no_log <description> <grep-pattern>
assert_no_log() {
  # shellcheck disable=SC2310 # an empty log is a legitimate result, not a script error
  captured="$(gesture_log || true)"
  if printf '%s\n' "${captured}" | grep -q "$2"; then
    fail "$1 (unexpectedly matched '$2')"
    printf '%s\n' "${captured}" | sed 's/^/        /' >&2
  else
    pass "$1"
  fi
}

resumed_activity() {
  "${ADB_BIN}" shell dumpsys activity activities 2>/dev/null |
    tr -d '\r' | grep -oE 'topResumedActivity.*' | head -1 || true
}

################################################################################
# Input

# monkey returns when the intent is sent, not when the app has drawn, and a stream
# delivered mid-draw arrives too slow to arm. So wait for the window.
open_test_app() {
  "${ADB_BIN}" shell monkey -p "${PKG}" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true
  focus_try=1
  while [ "${focus_try}" -le 20 ]; do
    if "${ADB_BIN}" shell dumpsys window 2>/dev/null | tr -d '\r' |
      grep -qE "mCurrentFocus.*${PKG}"; then
      break
    fi
    sleep 1
    focus_try=$((focus_try + 1))
  done
  sleep 1
}

# A quick continuous swipe: never holds still, so it can only ever mean the
# short action (Back / Home), never the hold action.
swipe() {
  "${ADB_BIN}" shell input swipe "$1" "$2" "$3" "$4" "${5:-120}" >/dev/null
}

# Arms and then genuinely holds still. Separate motionevents make the pause real:
# `input swipe` interpolates and would keep re-anchoring the hold timer.
swipe_and_hold() {
  "${ADB_BIN}" shell input motionevent DOWN "$1" "$2" >/dev/null
  "${ADB_BIN}" shell input motionevent MOVE "$3" "$4" >/dev/null
  sleep "${5:-0.6}"
  "${ADB_BIN}" shell input motionevent UP "$3" "$4" >/dev/null
}

# The device's first stream arrives stretched past the arm window whatever duration is
# asked for, so throwaway swipes go first. A fired Back closes the app, hence reopening.
warm_input() {
  warm=1
  while [ "${warm}" -le 6 ]; do
    open_test_app
    reset_log
    swipe 2 "${MID_Y}" 300 "${MID_Y}" 120
    sleep 2
    # shellcheck disable=SC2310 # a miss is the retry signal, not an error
    if gesture_log | grep -q "GESTURE_FIRED LEFT Back"; then
      echo "   input path warm after ${warm} throwaway swipe(s)" >&2
      return 0
    fi
    warm=$((warm + 1))
  done
  echo "   input path never warmed, the cases below report what the device did" >&2
}

################################################################################
# Geometry
#
# Sets WIDTH, HEIGHT, MID_Y, RIGHT_X and BOTTOM_Y for the suites.

# The strip spans the navigation-bar inset, but SystemUI outranks us there and claims a
# synthetic touch starting on the bar. So swipes start inside our own strip instead.
read_strip_height() {
  "${ADB_BIN}" logcat -d -s HyperGesture 2>/dev/null | tr -d '\r' |
    sed -n 's/.*strip BOTTOM installed [0-9]*x\([0-9]*\).*/\1/p' | tail -1
}

# The strip height is logged once, when the service binds, and a suite clears logcat
# between cases, so the first caller writes it down and the rest read that.
geometry() {
  if [ -f "${LOG_DIR}/geometry" ]; then
    read -r WIDTH HEIGHT strip_h <"${LOG_DIR}/geometry"
    MID_Y=$((HEIGHT / 2))
    RIGHT_X=$((WIDTH - 3))
    BOTTOM_Y=$((HEIGHT - strip_h + 8))
    return 0
  fi
  size="$("${ADB_BIN}" shell wm size | tr -d '\r' | awk -F': *' '{print $2}' | tail -1)"
  WIDTH="${size%x*}"
  HEIGHT="${size#*x}"
  if [ -z "${WIDTH}" ] || [ -z "${HEIGHT}" ]; then
    echo "Could not read screen size (got '${size}')" >&2
    exit 1
  fi
  MID_Y=$((HEIGHT / 2))
  RIGHT_X=$((WIDTH - 3))

  # Binding and installing are not the same moment: the strips go up when the settings
  # collector first emits, which is a DataStore read later. Reading once races that.
  strip_h=''
  attempt=1
  while [ "${attempt}" -le 30 ]; do
    # shellcheck disable=SC2310 # an empty result is the retry signal, not an error
    strip_h="$(read_strip_height)"
    if [ -n "${strip_h}" ]; then
      break
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  if [ -z "${strip_h}" ]; then
    echo "The strips were never installed (no 'strip BOTTOM installed' in 30s)." >&2
    echo "Last HyperGesture log lines:" >&2
    "${ADB_BIN}" logcat -d -s HyperGesture 2>/dev/null | tr -d '\r' | tail -10 | sed 's/^/    /' >&2
    exit 1
  fi
  BOTTOM_Y=$((HEIGHT - strip_h + 8))
  printf '%s %s %s\n' "${WIDTH}" "${HEIGHT}" "${strip_h}" >"${LOG_DIR}/geometry"
  echo "screen ${WIDTH}x${HEIGHT}, bottom strip ${strip_h}px tall, swiping from y=${BOTTOM_Y}" >&2
}

################################################################################
# Screen
#
# What the app shows, read through uiautomator.

# A failed dump leaves the last screen's file behind, so it is deleted first and the dump retried.
dump_nodes() {
  dump_try=1
  while [ "${dump_try}" -le 3 ]; do
    "${ADB_BIN}" shell rm -f /sdcard/hg-ui.xml >/dev/null 2>&1 || true
    if "${ADB_BIN}" shell uiautomator dump /sdcard/hg-ui.xml 2>/dev/null | grep -q 'dumped to'; then
      break
    fi
    sleep 1
    dump_try=$((dump_try + 1))
  done
  "${ADB_BIN}" exec-out cat /sdcard/hg-ui.xml 2>/dev/null | sed 's/<node /\
<node /g'
}

# tap_node <node line> - taps the centre of its bounds.
tap_node() {
  b="$(printf '%s\n' "$1" | sed -n 's/.*bounds="\[\([0-9]*\),\([0-9]*\)\]\[\([0-9]*\),\([0-9]*\)\]".*/\1 \2 \3 \4/p')"
  [ -n "${b}" ] || return 0
  # shellcheck disable=SC2086 # the four bounds are meant to split
  set -- ${b}
  "${ADB_BIN}" shell input tap $((($1 + $3) / 2)) $((($2 + $4) / 2)) >/dev/null
}

# A loaded emulator raises "System UI isn't responding" over the app, so wait it out.
ui_nodes() {
  nodes="$(dump_nodes)"
  if printf '%s\n' "${nodes}" | grep -q "isn't responding"; then
    tap_node "$(printf '%s\n' "${nodes}" | grep -m1 'text="Wait"' || true)"
    sleep 2
    nodes="$(dump_nodes)"
  fi
  printf '%s\n' "${nodes}"
}

# string_res <name> - the default-locale text of an app string.
string_res() {
  sed -n "s/.*name=\"$1\">\(.*\)<\/string>.*/\1/p" app/src/main/res/values/strings.xml
}

# scroll_app <up|down> - drags the app's own content, clear of every edge strip.
scroll_app() {
  size="$("${ADB_BIN}" shell wm size | tr -d '\r' | awk -F': *' '{print $2}' | tail -1)"
  w="${size%x*}"
  h="${size#*x}"
  if [ "$1" = 'up' ]; then
    "${ADB_BIN}" shell input swipe $((w / 2)) $((h / 3)) $((w / 2)) $((h * 2 / 3)) 300 >/dev/null
  else
    "${ADB_BIN}" shell input swipe $((w / 2)) $((h * 2 / 3)) $((w / 2)) $((h / 3)) 300 >/dev/null
  fi
}

# Test tags reach uiautomator as resource ids, so these select by tag rather than by text.

# find_id <tag> - scrolls the app from the top until that node's centre clears the bottom
# strip, which takes a tap there for itself, and prints the node.
find_id() {
  scroll_app up
  scroll_app up
  size="$("${ADB_BIN}" shell wm size | tr -d '\r' | awk -F': *' '{print $2}' | tail -1)"
  clear_y=$((${size#*x} - 260))
  found=''
  tries=1
  while [ "${tries}" -le 8 ]; do
    screen="$(ui_nodes)"
    found="$(printf '%s\n' "${screen}" | grep -m1 "resource-id=\"$1\"" || true)"
    centre="$(printf '%s\n' "${found}" |
      sed -n 's/.*bounds="\[[0-9]*,\([0-9]*\)\]\[[0-9]*,\([0-9]*\)\]".*/\1 \2/p' |
      awk '{print int(($1 + $2) / 2)}')"
    if [ -n "${centre}" ] && [ "${centre}" -lt "${clear_y}" ]; then
      printf '%s\n' "${found}"
      return 0
    fi
    scroll_app down
    sleep 1
    tries=$((tries + 1))
  done
  [ -n "${found}" ] || return 1
  printf '%s\n' "${found}"
}

# tap_id <tag> - taps the node with that tag.
tap_id() {
  # shellcheck disable=SC2310 # a missing node is reported by the caller
  node="$(find_id "$1")" || return 1
  tap_node "${node}"
}

# text_of_id <tag> - prints the text the node with that tag shows.
text_of_id() {
  # shellcheck disable=SC2310 # a missing node is reported by the caller
  node="$(find_id "$1")" || return 1
  printf '%s\n' "${node}" | sed -n 's/.* text="\([^"]*\)".*/\1/p'
}

# set_toggle_id <tag> <true|false> - sets the switch with that tag on the current screen.
set_toggle_id() {
  tapped=''
  tries=1
  while [ "${tries}" -le 6 ]; do
    # shellcheck disable=SC2310 # a missing node is retried and then reported below
    node="$(find_id "$1" || true)"
    case "${node}" in
      *"checked=\"$2\""*)
        echo "   '$1' is $2" >&2
        return 0
        ;;
      # Tapped once, since a loaded emulator redraws late and a second tap would undo it.
      *'checked="'*)
        if [ -z "${tapped}" ]; then
          tap_node "${node}"
          tapped='1'
        fi
        ;;
      *) ;;
    esac
    sleep 2
    tries=$((tries + 1))
  done
  echo "Could not set '$1' to $2 (tapped: ${tapped:-no}). On screen:" >&2
  ui_nodes | grep -o 'resource-id="[^"]\{1,\}"\|text="[^"]\{1,\}"' | sed 's/^/    /' >&2
  return 1
}

# open_test_app lands on whichever screen was open last, where Back only returns home.
# So a suite that touches the UI or needs Back to leave the app goes through these.

# to_home - taps the app bar's back arrow until home, which has none, is showing.
to_home() {
  back_try=1
  while [ "${back_try}" -le 6 ]; do
    back_node="$(ui_nodes | grep -m1 'resource-id="nav_back"' || true)"
    if [ -z "${back_node}" ]; then
      return 0
    fi
    tap_node "${back_node}"
    sleep 1
    back_try=$((back_try + 1))
  done
}

open_home() {
  open_test_app
  to_home
}

# open_screen <row tag> [<tag on that screen>] - opens the screen behind that row on home. With a
# second tag it retries until that node shows, since a tap on a home still settling can miss.
open_screen() {
  open_try=1
  while [ "${open_try}" -le 3 ]; do
    open_home
    # shellcheck disable=SC2310 # a missing row is reported by the caller's own assertion
    tap_id "$1" || echo "   no '$1' row on home" >&2
    sleep 1
    # shellcheck disable=SC2310 # a missing node is the retry signal, not an error
    if [ -z "${2:-}" ] || find_id "$2" >/dev/null; then
      return 0
    fi
    echo "   '$2' not shown after tapping '$1' (attempt ${open_try} of 3), on screen:" >&2
    ui_nodes | grep -o 'resource-id="[^"]\{1,\}"\|text="[^"]\{1,\}"' | sed 's/^/      /' >&2
    open_try=$((open_try + 1))
  done
}

# bottom_strip_frame - the left, top, right and bottom of the bottom strip's window as the window
# manager placed it, which is where a touch lands, unlike a size logged mid-rotation.
bottom_strip_frame() {
  "${ADB_BIN}" shell dumpsys window windows 2>/dev/null | tr -d '\r' | awk -v pkg="u0 ${PKG}}" '
    /^  Window #/ { mine = index($0, pkg) > 0; bottom = 0 }
    mine && /ty=ACCESSIBILITY_OVERLAY/ && /gr=BOTTOM CENTER/ { bottom = 1 }
    mine && bottom && / frame=\[/ {
      f = $0
      sub(/.* frame=\[/, "", f)
      sub(/\] last=.*/, "", f)
      gsub(/[^0-9-]+/, " ", f)
      split(f, b, " ")
      if (b[3] - b[1] > best) { best = b[3] - b[1]; out = b[1] " " b[2] " " b[3] " " b[4] }
      bottom = 0
    }
    END { if (out != "") print out }'
}

# display_rotation - 0 to 3, as the window manager has it now.
display_rotation() {
  "${ADB_BIN}" shell dumpsys window displays 2>/dev/null | tr -d '\r' |
    sed -n 's/.*mCurrentRotation=ROTATION_\([0-9]*\).*/\1/p' | head -1 |
    awk '{print $1 / 90}'
}

# wait_strip <rotation 0|1> - waits for that rotation and a bottom strip as wide as it, unmoved
# across two reads, and sets STRIP_TOP. The strip from before the turn lingers for seconds.
wait_strip() {
  last=''
  strip_try=1
  while [ "${strip_try}" -le 30 ]; do
    frame=''
    # shellcheck disable=SC2310 # a rotation still in flight is the retry signal
    if [ "$(display_rotation)" = "$1" ]; then
      frame="$(bottom_strip_frame)"
    fi
    span="$(printf '%s\n' "${frame}" | awk '{print $3 - $1}')"
    if [ -n "${frame}" ] && [ "${frame}" = "${last}" ]; then
      if { [ "$1" = '1' ] && [ "${span}" -gt "${WIDTH}" ]; } ||
        { [ "$1" = '0' ] && [ "${span}" -le "${WIDTH}" ]; }; then
        STRIP_TOP="$(printf '%s\n' "${frame}" | awk '{print $2}')"
        return 0
      fi
    fi
    last="${frame}"
    sleep 1
    strip_try=$((strip_try + 1))
  done
  return 1
}
