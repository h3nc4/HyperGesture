import { en } from "../i18n/en";
import { pt } from "../i18n/pt";
import "../styles/site.css";

// Wrangler serves one 404 page for every missing path, so it shows both languages.
const both = [en, pt];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>{en.notFound.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="sec">
      <div class="wrap">
        {
          both.map((t) => (
            <section lang={t.lang} class="lost">
              <h1>{t.notFound.title}</h1>
              <p class="prose">{t.notFound.body} <a href={t.home}>{t.notFound.back}</a></p>
            </section>
          ))
        }
      </div>
    </main>
  </body>
</html>

<style is:global>
  .lost + .lost{margin-top:48px}
  .lost h1{font-size:clamp(1.875rem,1.4rem + 2vw,3rem)}
</style>
