import { encode } from "uqr";

interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
const qr = encode(value, { ecc: "L", border: 0 });

// One horizontal run per row keeps the path a few kilobytes.
let d = "";
qr.data.forEach((row, y) => {
  for (let x = 0; x < row.length; x++) {
    if (!row[x]) continue;
    const start = x;
    while (row[x + 1]) x++;
    d += `M${start} ${y}h${x - start + 1}v1h-${x - start + 1}z`;
  }
});
const quiet = 2;
---

<svg viewBox={`${-quiet} ${-quiet} ${qr.size + 2 * quiet} ${qr.size + 2 * quiet}`} role="img" aria-label={label} shape-rendering="crispEdges">
  <path fill="#151918" d={d} />
</svg>
