interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<div class="strips">
  <svg viewBox="0 0 120 220" aria-hidden="true">
    <rect class="st-frame" x="2" y="2" width="116" height="216" rx="18" />
    <rect class="st-on" x="6" y="30" width="5" height="150" rx="2.5" />
    <rect class="st-on" x="109" y="30" width="5" height="150" rx="2.5" />
    <rect class="st-on" x="20" y="207" width="80" height="5" rx="2.5" />
  </svg>
  <p>{caption}</p>
</div>

<style is:global>
  .strips{display:flex;gap:20px;align-items:center}
  .strips svg{width:96px;height:auto;flex:none}
  .strips p{color:var(--muted);font-size:.9375rem}
  .st-frame{fill:var(--surface);stroke:var(--muted);stroke-width:2}
  .st-on{fill:var(--accent)}
  @media (min-width:900px){
    .strips{flex-direction:column;align-items:flex-start}
    .strips svg{width:150px}
  }
</style>
