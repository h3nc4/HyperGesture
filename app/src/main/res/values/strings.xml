    <!-- Shown by the system in the accessibility settings list. -->
    <string name="accessibility_service_description">Recognises swipes from the screen edges and performs Back, Home and Recents. Used for navigation only: HyperGesture never reads screen content, text or keystrokes, and sends nothing off your device.</string>
    <string name="accessibility_service_summary">Edge gesture navigation</string>

