<!-- Setup progress, the hidden-bar record and the diagnostic logs describe one phone, so a new one starts them fresh. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/setup_state.preferences_pb" />
        <exclude domain="file" path="datastore/navigation_keeper.preferences_pb" />
        <exclude domain="file" path="last_failure.txt" />
        <exclude domain="external" path="stuck_streams.txt" />
        <exclude domain="file" path="stuck_streams.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/setup_state.preferences_pb" />
        <exclude domain="file" path="datastore/navigation_keeper.preferences_pb" />
        <exclude domain="file" path="last_failure.txt" />
        <exclude domain="external" path="stuck_streams.txt" />
        <exclude domain="file" path="stuck_streams.txt" />
    </device-transfer>
</data-extraction-rules>
