    <string name="app_name">HyperGesture</string>

    <!-- Shown by the system in the accessibility settings list. -->
    <string name="accessibility_service_description">Reconhece deslizes a partir das bordas da tela e executa Voltar, Início e Recentes. O serviço é só para navegação, não lê o conteúdo da tela nem o que você digita, e não envia nada para fora do seu aparelho. O app só fala com o GitHub se você ativar a verificação de atualizações.</string>
    <string name="accessibility_service_summary">Navegação por gestos nas bordas</string>

